# Node 24. No external API or AI keys are required.
HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://localhost:4310
DATA_DIR=./data
DEMO_MODE=false
SECURE_COOKIE=false
# Set HTTPS origin and SECURE_COOKIE=true before any approved remote pilot.
# Approved deployment only: NODE_ENV=production and an absolute persistent DATA_DIR.
# Run npm run preflight before deployment. It never deploys or initializes a DB.
# Optional external adapters are disabled by default. Never commit real credentials.

# 조달청: 이용승인 + 서버 전용 서비스키가 있는 경우에만 활성화
PROCUREMENT_ENABLED=false
DATA_GO_KR_SERVICE_KEY=
# 참고사진 재사용 조건을 확인한 경우에만 true (현물 증거로 사용하지 않음)
PROCUREMENT_IMAGE_RIGHTS_CONFIRMED=false

# AI: 기관의 자료 전송 승인 + 이미지/JSON Schema 지원 모델 확인 후 활성화
AI_ENABLED=false
AI_DATA_APPROVED=false
OPENAI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=20

# 주소검색과 운행거리 서비스는 서로 다른 자격/이용조건을 확인
LOCATION_ENABLED=false
KAKAO_REST_API_KEY=
ROUTE_ENABLED=false
KAKAO_MOBILITY_REST_API_KEY=

# 비어 있으면 시연용 가정 단가. 업체 확정 견적 API가 아님.
# server/shipping.mjs의 rateCardSchema를 따르는 JSON을 보안 환경설정으로 제공.
SHIPPING_RATE_CARD_JSON=

# RAG 업무도우미 (기존 사진 AI 설정과 별개)
RAG_AI_ENABLED=false
# deepseek (기본 직결) 또는 hive (기존 OpenCode의 승인된 Hive 연결)
RAG_PROVIDER=deepseek
RAG_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# hive 선택 시 서버에만 설정하고 RAG_MODEL=deepseek-ai/deepseek-v4.1-flash-1017 지정
HIVE_API_KEY=
RAG_EXTERNAL_APPROVED=false
RAG_DAILY_LIMIT=50
# 기관 간 공유가 허용된 참조 지침 자료만 설치
RAG_LIBRARY_ENABLED=false
RAG_CORPUS_DIR=
RAG_LIBRARY_EXTERNAL_APPROVED=false

# v0.6: procurement lookup policy (all real credentials stay server-side).
# The default follows the verified official Swagger.
PROCUREMENT_KEY_PARAM=serviceKey
PROCUREMENT_DAILY_LIMIT=300
PROCUREMENT_GLOBAL_DAILY_LIMIT=800
PROCUREMENT_CACHE_TTL_SECONDS=21600

# v0.7 Optional private OZD -> XLSX bridge. This is NOT a procurement API.
# Retain existing DeepSeek / procurement credentials; do not replace them.
OZD_BRIDGE_ENABLED=false
OZD_BRIDGE_APPROVED=false
OZD_BRIDGE_URL=
OZD_BRIDGE_TOKEN=
OZD_BRIDGE_TIMEOUT_MS=60000
# Remote plain HTTP requires an explicitly approved isolated private network.
OZD_ALLOW_PRIVATE_HTTP=false

# v0.8 private conversion HOST ONLY (no actual vendor SDK is distributed).
# Use these with the private OZD bridge .env.ozd, not frontend/public env vars.
# OZD_ENGINE_KIND=OZ_HTML5
# OZD_ENGINE_APPROVED=false
# OZD_HTML5_LICENSE_CONFIRMED=false
# OZD_HTML5_ASSET_DIR=/path/to/licensed/ozrviewer
# OZD_HTML5_BROWSER_PATH=/path/to/installed/chrome
# OZD_HTML5_SCRIPTS_JSON=["OZJSViewer.js"]
# OZD_HTML5_STYLES_JSON=[]
# OZD_HTML5_TIMEOUT_MS=40000
# OZD_ENGINE_TIMEOUT_MS=65000

# v0.9 OZD native conversion is built in; requires no extra environment variables.
# Only keep this opt-in for separately approved legacy converters. Native runs first.
OZD_LEGACY_BRIDGE_FALLBACK=false

# AI search/automatic registration. Reuses DEEPSEEK_API_KEY and RAG_MODEL above.
# Explicitly approve product/query data before enabling outbound text-model calls.
# AI_CORE_ENABLED=true
AI_CORE_DATA_APPROVED=false
AI_CORE_DAILY_LIMIT=100
# AI_CORE_MODEL=   # optional; omit to preserve existing RAG_MODEL
