{
  "name": "mulppum-ieum",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "rag:check": "node --env-file-if-exists=.env scripts/rag-check.mjs",
    "ozd:bridge": "node --env-file-if-exists=.env.ozd tools/ozd-bridge/server.mjs",
    "ozd:html5:check": "node --env-file-if-exists=.env.ozd tools/ozd-bridge/check-html5.mjs",
    "ozd:convert": "node scripts/ozd-convert.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "playwright-core": "1.64.1",
    "pretendard": "1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
